module(
    name = "zenoh",
    version = "1.7.2",
)

bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_rust", version = "0.68.1")

# Use a RUST compiler known to work with Zenoh.

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.85.1"],
)

# Load the Zenoh crates.

crate = use_extension(
    "@rules_rust//crate_universe:extension.bzl",
    "crate",
)
crate.from_cargo(
    name = "crates_zenoh",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        #"//zenoh:Cargo.toml",
        #"//zenohd:Cargo.toml",
        # "//zenoh-ext:Cargo.toml",
        # "//zenoh-ext/examples:Cargo.toml",
        # "//plugins/zenoh-plugin-trait:Cargo.toml",
        # "//plugins/zenoh-backend-traits:Cargo.toml",
        # "//plugins/zenoh-plugin-example:Cargo.toml",
        # "//plugins/zenoh-plugin-rest:Cargo.toml",
        # "//plugins/zenoh-backend-example:Cargo.toml",
        # "//plugins/zenoh-plugin-storage-manager:Cargo.toml",
        # "//commons/zenoh-buffers:Cargo.toml",
        # "//commons/zenoh-codec:Cargo.toml",
        # "//commons/zenoh-collections:Cargo.toml",
        # "//commons/zenoh-config:Cargo.toml",
        # "//commons/zenoh-core:Cargo.toml",
        # "//commons/zenoh-crypto:Cargo.toml",
        # "//commons/zenoh-keyexpr:Cargo.toml",
        # "//commons/zenoh-macros:Cargo.toml",
        # "//commons/zenoh-pinned-deps-1-75:Cargo.toml",
        # "//commons/zenoh-protocol:Cargo.toml",
        # "//commons/zenoh-result:Cargo.toml",
        # "//commons/zenoh-runtime:Cargo.toml",
        # "//commons/zenoh-shm:Cargo.toml",
        # "//commons/zenoh-stats:Cargo.toml",
        # "//commons/zenoh-sync:Cargo.toml",
        # "//commons/zenoh-task:Cargo.toml",
        # "//commons/zenoh-util:Cargo.toml",
        # "//examples:Cargo.toml",
        # "//io/zenoh-link:Cargo.toml",
        # "//io/zenoh-links/zenoh-link-quic_datagram:Cargo.toml",
        # "//io/zenoh-links/zenoh-link-tls:Cargo.toml",
        # "//io/zenoh-links/zenoh-link-quic:Cargo.toml",
        # "//io/zenoh-links/zenoh-link-unixpipe:Cargo.toml",
        # "//io/zenoh-links/zenoh-link-tcp:Cargo.toml",
        # "//io/zenoh-links/zenoh-link-serial:Cargo.toml",
        # "//io/zenoh-links/zenoh-link-udp:Cargo.toml",
        # "//io/zenoh-links/zenoh-link-ws:Cargo.toml",
        # "//io/zenoh-links/zenoh-link-unixsock_stream:Cargo.toml",
        # "//io/zenoh-links/zenoh-link-vsock:Cargo.toml",
        # "//io/zenoh-transport:Cargo.toml",
        # "//io/zenoh-link-commons:Cargo.toml",
    ]
)
use_repo(crate, "crates_zenoh")